<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <!-- Focus coverage on main library assembly -->
          <Include>[IndQuestResults]*</Include>
          <!-- Exclude tests, samples, analyzers, and benchmarks assemblies -->
          <Exclude>[*.Tests*]*,[*.Samples*]*,[*.Benchmarks*]*,[IndQuestResults.Analyzers*]*</Exclude>
          <!-- Optional: ignore generated/infra files -->
          <ExcludeByFile>**/Generated/**,**/Migrations/**,**/*.g.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
