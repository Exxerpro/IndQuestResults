{
  "stryker-config": {
    "project": "../../IndQuestResults.sln",
    "mutate": [
      "../../src/IndQuestResults/**/*.cs",
      "!**/*Tests.cs",
      "!**/*Test.cs", 
      "!**/bin/**",
      "!**/obj/**"
    ],
    "ignore-methods": [
      "*Log*",
      "*ToString*",
      "*GetHashCode*",
      "*Equals*"
    ],
    "reporters": ["html", "progress", "json"],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    },
    "verbosity": "info",
    "concurrency": 4,
    "report-file-name": "indquest-results-simple-mutation-report"
  }
}