<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>IndQuestResults.Tests.Unit</RootNamespace>
    <AssemblyName>IndQuestResults.Tests.Unit</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Test Configuration -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>../../../artifacts/coverage/unit/</CoverletOutput>
    <Threshold>95</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IndQuestResults\IndQuestResults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Additional test utilities beyond Directory.Build.props -->
    <PackageReference Include="AutoFixture" Version="4.18.1" />
  </ItemGroup>

  <!-- Test Data -->
  <ItemGroup>
    <EmbeddedResource Include="TestData\**\*.json" />
  </ItemGroup>

</Project>