<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>IndQuestResults.Samples.Advanced</RootNamespace>
    <AssemblyName>IndQuestResults.Samples.Advanced</AssemblyName>
  </PropertyGroup>

  <!-- Toggle between local project references and NuGet package consumption -->
  <PropertyGroup>
    <UseLocalRefs Condition="'$(UseLocalRefs)' == ''">false</UseLocalRefs>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalRefs)' == 'true'">
    <ProjectReference Include="..\..\src\IndQuestResults\IndQuestResults.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRefs)' != 'true'">
    <PackageReference Include="IndQuestResults" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Examples\RailwayProgrammingExamples.cs" />
    <Compile Include="Examples\AsyncPipelineExamples.cs" />
    <Compile Include="Examples\PerformanceOptimizationExamples.cs" />
    <Compile Include="Examples\CancellationExamples.cs" />
    <Compile Include="Examples\WarningSystemExamples.cs" />
    <Compile Include="Examples\SerializationExamples.cs" />
    <Compile Include="Services\UserService.cs" />
    <Compile Include="Services\ValidationService.cs" />
    <Compile Include="Models\User.cs" />
    <Compile Include="Models\ValidationResult.cs" />
  </ItemGroup>

</Project>
