<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>IndQuestResults.Samples.Basic</RootNamespace>
    <AssemblyName>IndQuestResults.Samples.Basic</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Toggle between local project references and NuGet package consumption -->
  <!-- Toggle between local project references and NuGet package consumption -->
  <PropertyGroup>
    <UseLocalRefs Condition="'$(UseLocalRefs)' == ''">false</UseLocalRefs>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalRefs)' == 'true'">
    <ProjectReference Include="..\..\src\IndQuestResults\IndQuestResults.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRefs)' != 'true'">
    <PackageReference Include="IndQuestResults" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IndQuestResults\IndQuestResults.csproj" />
  </ItemGroup>


</Project>
