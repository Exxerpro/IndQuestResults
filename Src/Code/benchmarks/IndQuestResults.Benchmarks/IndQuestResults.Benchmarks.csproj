<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IndQuestResults.Benchmarks</RootNamespace>
    <AssemblyName>IndQuestResults.Benchmarks</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyVersion>1.0.1.2</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup>

    <!-- Suppress additional warnings for benchmark projects -->
    <NoWarn>$(NoWarn);CA1707;CA1822;CA1311;CA1304;CA1861;CA1860;IDE0200;IDE0052</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IndQuestResults\IndQuestResults.csproj" />
  </ItemGroup>


</Project>