<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>IndQuestResults.Benchmarks</RootNamespace>
    <AssemblyName>IndQuestResults.Benchmarks</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <PropertyGroup>
    <UseLocalRefs Condition="'$(UseLocalRefs)' == ''">false</UseLocalRefs>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalRefs)' == 'true'">
    <ProjectReference Include="..\..\src\IndQuestResults\IndQuestResults.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRefs)' != 'true'">
    <PackageReference Include="IndQuestResults" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ResultCreationBenchmarks.cs" />
    <Compile Include="ErrorFormattingBenchmarks.cs" />
    <Compile Include="FluentApiPerformanceBenchmarks.cs" />
    <Compile Include="SpanOptimizationBenchmarks.cs" />
    <Compile Include="ConcurrencyBenchmarks.cs" />
    <Compile Include="MemoryAllocationBenchmarks.cs" />
    <Compile Include="ComparisonBenchmarks.cs" />
  </ItemGroup>

</Project>