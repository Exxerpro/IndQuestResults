<Project>

  <!-- Import common properties -->
  <Import Project="$(MSBuildThisFileDirectory)Common.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
    ==================================================================================
    WARNING CONFIGURATION - Detailed Warning Explanations
    ==================================================================================

    ENABLED AS ERROR:
    - CS1591: Missing XML comment for publicly visible type or member
      * This ensures all public APIs have documentation

    Naming (IDE Rules):
    - IDE1006: Naming rule violation: Missing prefix: '_'
      * Private fields should start with underscore according to style rules

    ALLOWED AS WARNINGS (WarningsNotAsErrors):
    - NU1605: Package downgrade warnings in NuGet
    - NU1902: Package vulnerability warnings
    - DV2001: Dependency validation warnings

    STRATEGY RATIONALE:
    This configuration focuses on functional correctness (ensuring all public APIs are documented)
    while treating style preferences as warnings rather than build-breaking errors. This approach:

    1. Maintains documentation quality - CS1591 as error ensures no public API lacks documentation
    2. Allows flexible coding styles - Teams can have different preferences on var usage, bracing, etc.
    3. Prevents build failures from cosmetic issues - Style warnings don't stop development workflow
    4. Focuses on what matters - Documentation and functionality over formatting preferences
    ==================================================================================
    -->

    <!-- Treat ALL warnings as errors for production (packable) projects -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1605;NU1902;DV2001</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress stylistic/perf suggestions to keep builds clean; behavior is enforced by tests/mutation -->
    <NoWarn>
      $(NoWarn);
      IDE0005;IDE0008;IDE0055;IDE0058;IDE0060;IDE0305;IDE1006;CA1000;CA1305;
    </NoWarn>
  </PropertyGroup>
  <!-- SUPPRESSED WARNINGS (NoWarn):

  Code Style (IDE Rules):
  - IDE0055: Fix formatting
  * Code formatting suggestions (whitespace, indentation, etc.)
  - IDE0008: Use explicit type instead of 'var'
  * Opposite of IDE0007 - conflicts in style preferences

    * Additional collection initialization simplifications
    - IDE0300: Collection initialization can be simplified*/ -
    * Newer C# collection syntax suggestions
    - IDE0058: Expression value is never used
    * Suggests using discard (_) for unused return values
 Code Quality (CA Rules):
    - CA1000: Do not declare static members on generic types
        * Resource management warnings
    - CA1305: Culture-specific formatting warnings
      * Locale-dependent string operations
-->

  <PropertyGroup>
    <!-- Package Information -->
    <Product>IndQuestResults</Product>
    <Company>Exxerpro Solutions SA de CV</Company>
    <Authors>Exxerpro Engineering Team</Authors>
    <Copyright>Copyright © Exxerpro Solutions SA de CV 2025</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/exxerpro/IndQuestResults</PackageProjectUrl>
    <RepositoryUrl>https://github.com/exxerpro/IndQuestResults</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>result;functional;error-handling;railway;monad;csharp;dotnet</PackageTags>
    <Description>Enterprise-grade Result&lt;T&gt; library for functional error handling in .NET applications. Battle-tested with extensive mutation testing coverage.</Description>
    <!-- Readme and Icon are included conditionally below -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>IconIndQuestResult.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Version Information -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev</VersionSuffix>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Build Configuration -->
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputPath>..\..\artifacts\bin\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
    <BaseIntermediateOutputPath>..\..\artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <PackageOutputPath>..\..\artifacts\packages\</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Test Projects Only -->
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('Tests'))">
    <NoWarn>$(NoWarn);CS1587</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.Contains('Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <!-- Mutation Testing -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('Mutation'))">
    <!-- Stryker is configured as a global tool in global.json -->
  </ItemGroup>

  <!-- Benchmarking -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('Benchmarks'))">
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <!-- Solution Items -->
  <ItemGroup Condition="'$(IsPackable)' != 'true'">
    <None Include="$(MSBuildThisFileDirectory)Directory.Build.props" />
    <None Include="$(MSBuildThisFileDirectory)Directory.Packages.props" />
  </ItemGroup>

  <!-- Include package assets for packable projects -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <!-- Include repo README as package readme -->
    <None Include="$(MSBuildThisFileDirectory)..\\..\\README.md" Pack="true" PackagePath="/" Link="README.md" />
    <!-- Include icon if it exists -->
    <None Include="$(MSBuildThisFileDirectory)src/IndQuestResults/IconIndQuestResult.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
