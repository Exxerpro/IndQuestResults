<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet console app, not a test assembly: dotnet test aborts on it (no test framework).
         Run explicitly via `dotnet run` when benchmarking. -->
    <IsTestProject>false</IsTestProject>
    <RootNamespace>IndQuestResults.Tests.Performance</RootNamespace>
    <AssemblyName>IndQuestResults.Tests.Performance</AssemblyName>
    <OutputType>Exe</OutputType>
    <StartupObject>IndQuestResults.Tests.Performance.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyVersion>1.2.0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup>

    <!-- Suppress additional warnings for performance test projects -->
    <NoWarn>$(NoWarn);CA1861;CA1304;CA1311;IDE0048;IDE0047;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IndQuestResults\IndQuestResults.csproj" />
  </ItemGroup>


</Project>
