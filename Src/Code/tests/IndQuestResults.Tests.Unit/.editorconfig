# Scoped configuration for unit test project only

[*.cs]
# Allow underscores in identifiers for tests by disabling CA1707 here
dotnet_diagnostic.CA1707.severity = none



# IDE0320: Make anonymous function static
dotnet_diagnostic.IDE0320.severity = suggestion

# Default severity for analyzer diagnostics with category 'Style'
dotnet_analyzer_diagnostic.category-Style.severity = silent
