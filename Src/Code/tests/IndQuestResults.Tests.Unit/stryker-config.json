{
  "stryker-config": {
    "project": "../../IndQuestResults.sln",
    "test-projects": [
      "IndQuestResults.Tests.Unit.csproj"
    ],
    "mutate": [
      "../../src/IndQuestResults/Operations/ResultExtensions.cs{34..38}",
      "../../src/IndQuestResults/Operations/ResultExtensions.cs{45..48}"
    ],
    "ignore-mutations": [
    ],
    "coverage-analysis": "perTestInIsolation",
    "concurrency": 4,
    "additional-timeout": 30000,
    "thresholds": {
      "high": 90,
      "low": 75,
      "break": 0
    },
    "reporters": ["html", "progress", "json"],
    "verbosity": "info",
    "language-version": "latest"
  }
}
