<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>IndQuestResults.Tests.Unit</RootNamespace>
    <AssemblyName>IndQuestResults.Tests.Unit</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyVersion>1.0.1.2</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Test Configuration -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>../../../artifacts/coverage/unit/</CoverletOutput>
    <Threshold>95</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Additional test utilities beyond Directory.Build.props -->
    <PackageReference Include="AutoFixture" />
  </ItemGroup>

  <PropertyGroup>
    <UseLocalRefs Condition="'$(UseLocalRefs)' == ''">true</UseLocalRefs>
    <!-- Suppress additional warnings for unit test projects -->
    <NoWarn>$(NoWarn);CS1591;CS8625;CA1861;IDE0004;IDE0028;IDE0200;IDE0011;CA2201;IDE0300;IDE0350;CA1852;IDE0053;CA1829</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalRefs)' != 'true'">
    <PackageReference Include="IndQuestResults" />
    <PackageReference Include="IndQuestResults.Extensions.Collections" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IndQuestResults\IndQuestResults.csproj" />
  </ItemGroup>

  <!-- Test Data -->
  <ItemGroup>
    <EmbeddedResource Include="TestData\**\*.json" />
  </ItemGroup>

</Project>
