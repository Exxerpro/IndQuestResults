<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
    <!-- Warnings as Errors Configuration -->
    <!-- Warnings as Errors Configuration -->
    <WarningsAsErrors />
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Language Features -->
    <!-- Microsoft Testing Platform - Disabled for Stryker compatibility -->
    <!-- See: https://github.com/stryker-mutator/stryker-net/issues/3094 -->
  
    
    <!-- Keep existing properties -->
    <RootNamespace>IndQuestResults.Tests.Unit</RootNamespace>
    <AssemblyName>IndQuestResults.Tests.Unit</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    
    <AssemblyVersion>1.2.0</AssemblyVersion>
    
    <!-- Prevent Directory.Build.props from auto-adding xUnit v2 packages -->
    <DisableImplicitXUnitPackages>true</DisableImplicitXUnitPackages>

    <!-- xUnit v3 requires an executable app host on all builds (SDK 10.0.3xx enforces this) -->
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <!-- ============================================================================ -->
  <!-- TESTING PLATFORM PROPERTIES -->
  <!-- ============================================================================ -->
  <PropertyGroup>
    <!-- Microsoft Testing Platform Configuration -->
   
    <ImplicitUsings>enable</ImplicitUsings>

    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformServer>true</TestingPlatformServer>
    <!-- xunit.v3 supplies the entry point; MTP only contributes SelfRegisteredExtensions -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Test Configuration -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>../../../artifacts/coverage/unit/</CoverletOutput>
    <Threshold>95</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <!-- Remove Microsoft Testing Platform packages during Stryker runs -->
  <PropertyGroup Condition="'$(STRYKER_MUTATION_TEST)' != ''">
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup Condition="'$(STRYKER_MUTATION_TEST)' != ''">
    <PackageReference Remove="Microsoft.Testing.Platform" />
    <PackageReference Remove="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Remove="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  
  <ItemGroup Label="xUnit v3">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.v3.core" />
  </ItemGroup>
  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - VISUAL STUDIO RUNNER -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Runners">
    <PackageReference Include="xunit.v3.runner.inproc.console" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - TESTING UTILITIES -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Testing Utilities">
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Enrichers.Demystifier" />
  </ItemGroup>
 
  <ItemGroup Label="Core Testing">

    <!-- Keep AutoFixture from original -->
    <PackageReference Include="AutoFixture" />
  </ItemGroup>

  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - LOGGING EXTENSIONS -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Logging">
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Meziantou.Extensions.Logging.Xunit.v3" />
  </ItemGroup>
  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - TIME TESTING -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Time Testing">
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - ANALYZERS -->
  <!-- ============================================================================ -->
  <ItemGroup Label="NSubstitute Analyzers">
    <PackageReference Include="NSubstitute.Analyzers.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- ============================================================================ -->
  <!-- MICROSOFT TESTING PLATFORM -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Microsoft Testing Platform">
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <!--<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />-->
  </ItemGroup>
  <!-- ============================================================================ -->
  <!-- PROJECT CAPABILITIES -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Testing Platform Capabilities">
    <ProjectCapability Include="DiagnoseCapabilities" />
    <ProjectCapability Include="TestingPlatformServer" />
    <ProjectCapability Include="TestContainer" />
  </ItemGroup>

  <PropertyGroup>
    
    <!-- Suppress additional warnings for unit test projects -->
    <!-- xUnit1051: Suppress CancellationToken analyzer rule until migration is complete -->
    <NoWarn>$(NoWarn);CS1591;CS8625;CA1861;IDE0004;IDE0028;IDE0200;IDE0011;CA2201;IDE0300;IDE0350;CA1852;IDE0053;CA1829;xUnit1051;IL2026</NoWarn>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\src\IndQuestResults\IndQuestResults.csproj" />
  </ItemGroup>

  <!-- Test Data -->
  <ItemGroup>
    <EmbeddedResource Include="TestData\**\*.json" />
  </ItemGroup>

</Project>
