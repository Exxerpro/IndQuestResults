{
  "stryker-config": {
    "test-projects": [
      "IndQuestResults.Tests.Unit.csproj"
    ],
    "mutate": [
      "../../src/IndQuestResults/Result.cs",
      "../../src/IndQuestResults/ResultGeneric.cs",
      "../../src/IndQuestResults/ResultMetadataExtensions.cs"
    ],
    "test-case-filter": "FullyQualifiedName~ResultMetadataTests",
    "ignore-mutations": [
      "**/*AssemblyInfo.cs",
      "**/*GlobalUsings.cs"
    ],
    "coverage-analysis": "perTestInIsolation",
    "concurrency": 2,
    "additional-timeout": 60000,
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 60
    },
    "reporters": ["html", "progress", "json"],
    "verbosity": "info",
    "language-version": "latest"
  }
}

