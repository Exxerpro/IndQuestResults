<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    
    <!-- Temporarily disable Central Package Management for this project -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    
    <!-- Test-specific warning suppressions (CS1591 removed per request)
         CA1707  : Identifiers should not contain underscores (common in test names)
         NU1701  : Package restored using target framework fallback (acceptable for test-only transitive packages)
         CS1570  : XML comment has badly formed XML or invalid chars (can appear inside embedded code samples used as test inputs)
         CS1705  : Assembly uses a higher version than referenced (temporary analyzer/Test SDK binding differences during test harness runs)
         CS0246  : Type or namespace not found (expected in negative analyzer test cases that intentionally reference missing symbols)
         MSB3277 : Assembly version conflicts found (benign in test harness multi-target/transitive scenarios)
         NU1903  : Package vulnerability warnings (acceptable for test-only dependencies)
         NU1904  : Package vulnerability warnings (acceptable for test-only dependencies)
    -->
    <NoWarn>$(NoWarn);CA1707;NU1701;CS1570;CS1705;CS0246;MSB3277;NU1903;NU1904</NoWarn>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup Label="xUnit v2">
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup Label="Visual Studio Runner">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <ItemGroup Label="Analyzer Testing Framework">
    <!-- Core Roslyn packages for manual analyzer testing -->
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <!-- Force Roslyn version to match analyzer assembly -->
    <PackageReference Include="Microsoft.CodeAnalysis" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Testing Utilities">
    <!-- Enhanced Testing & Assertions -->
    <PackageReference Include="Shouldly" Version="4.3.0" /> 
    
    <!-- Snapshot testing for verifying outputs -->
    <PackageReference Include="EmptyFiles" Version="7.0.0" />
    
    <!-- Logging for debugging analyzer tests -->
    <PackageReference Include="Meziantou.Extensions.Logging.Xunit" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    
    <!-- Performance Testing (if needed for analyzer performance tests) -->
    <!-- Pin Roslyn to 4.14.0 transitively via BenchmarkDotNet by selecting a compatible version -->
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" Condition="'$(Configuration)' == 'Release'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the analyzer project -->
    <ProjectReference Include="..\..\src\IndQuestResults.Analyzers\IndQuestResults.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\IndQuestResults\IndQuestResults.csproj" />
  </ItemGroup>

</Project>