{
  "stryker-config": {
    "project": "../../src/IndQuestResults.Extensions.Async/IndQuestResults.Extensions.Async.csproj",
    "test-projects": [
      "IndQuestResults.Extensions.Async.Tests.csproj"
    ],
    "mutate": [
      "../../src/IndQuestResults.Extensions.Async/**/*.cs",
      "!../../src/IndQuestResults.Extensions.Async/**/GlobalUsings.cs"
    ],
    "ignore-mutations": [
      "String",
      "StringMethod",
      "Conditional",
      "NullCoalescing"
    ],
    "coverage-analysis": "off",
    "concurrency": 4,
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 60
    },
    "reporters": [
      "Progress",
      "Html",
      "Json"
    ],
    "verbosity": "info"
  }
}