{
  "stryker-config": {
    "project": "../../IndQuestResults.sln",
    "test-projects": [
      "../IndQuestResults.Tests.Unit/IndQuestResults.Tests.Unit.csproj",
      "../IndQuestResults.Tests.Performance/IndQuestResults.Tests.Performance.csproj"
    ],
    "mutate": [
      "../../src/IndQuestResults/**/*.cs",
      "!**/*Tests.cs",
      "!**/*Test.cs", 
      "!**/bin/**",
      "!**/obj/**",
      "!**/*.Designer.cs",
      "!**/*.g.cs",
      "!**/*.g.i.cs",
      "!**/AssemblyInfo.cs",
      "!**/GlobalUsings.cs",
      "!**/Program.cs"
    ],
    "ignore-methods": [
      "Console.Write*", 
      "LogDebug",
      "LogInformation", 
      "LogWarning",
      "LogError",
      "LogCritical",
      "LogTrace",
      "*Log*Debug*",
      "*Log*Information*", 
      "*Log*Warning*",
      "*Log*Error*",
      "*Log*Critical*",
      "*Log*Trace*",
      "*Task.Delay*",
      "*ArgumentNullException*",
      "*ArgumentException*",
      "*ToString*",
      "*GetHashCode*",
      "*Equals*"
    ],
    "ignore-mutations": [
      "String"
    ],
    "mutation-level": "Standard",
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 60
    },
    "coverage-analysis": "perTestInIsolation",
    "reporters": ["html", "progress", "json"],
    "verbosity": "info",
    "concurrency": 8,
    "disable-bail": false,
    "break-on-initial-test-failure": false,
    "report-file-name": "indquest-results-mutation-report",
    "language-version": "latest",
    "timeout-ms": 30000,
    "baseline": {
      "provider": "dashboard",
      "dashboard": {
        "project": "IndQuestResults",
        "version": "main"
      }
    }
  }
}