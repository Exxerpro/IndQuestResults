<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>IndQuestResults</RootNamespace>
    <AssemblyName>IndQuestResults</AssemblyName>
    <PackageId>IndQuestResults</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Minimal package info for now -->
    <Title>IndQuestResults - Enterprise Result&lt;T&gt; Library</Title>
    <Description>Enterprise-grade Result&lt;T&gt; library for functional error handling in .NET applications.</Description>
    <Version>1.0.0</Version>
    <Authors>Exxerpro Engineering Team</Authors>
    <Company>Exxerpro Solutions SA de CV</Company>
    <Copyright>Copyright © Exxerpro Solutions SA de CV 2025</Copyright>
  </PropertyGroup>


  <PropertyGroup>
    <!-- Enable performance optimizations -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <!-- Force treat warnings as errors for this production package -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Relax warnings during mutation testing runs (opt-in via env var) -->
  <PropertyGroup Condition="'$(STRYKER_MUTATION_TEST)' == 'true'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
