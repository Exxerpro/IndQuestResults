<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Removed net8.0 due to Lock type requirement (introduced in .NET 9.0) -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>IndQuestResults</RootNamespace>
    <AssemblyName>IndQuestResults</AssemblyName>
    <PackageId>IndQuestResults</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- Package metadata only -->
    <PackageDescription>Enterprise-grade Result&lt;T&gt; library for functional error handling in .NET applications. Requires .NET 9.0+ for Lock type support.</PackageDescription>
    <PackageVersion>1.2.0</PackageVersion>
    <AssemblyVersion>1.2.0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Enable performance optimizations -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <!-- Force treat warnings as errors for this production package -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>


  <!-- Relax warnings during mutation testing runs (opt-in via env var) -->
  <PropertyGroup Condition="'$(STRYKER_MUTATION_TEST)' == 'true'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
