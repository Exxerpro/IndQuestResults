<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>IndQuestResults.Extensions.Collections</RootNamespace>
    <AssemblyName>IndQuestResults.Extensions.Collections</AssemblyName>
    <PackageId>IndQuestResults.Extensions.Collections</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <Title>IndQuestResults Collections Extensions</Title>
    <Description>Collection utilities and bulk operations for IndQuestResults library.</Description>
    <Version>1.0.0</Version>
    <Authors>Exxerpro Engineering Team</Authors>
    <Company>Exxerpro Solutions SA de CV</Company>
    <Copyright>Copyright © Exxerpro Solutions SA de CV 2025</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IndQuestResults\IndQuestResults.csproj" />
  </ItemGroup>


</Project>
